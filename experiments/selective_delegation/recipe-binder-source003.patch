+import json
+
+import analyze_textcraft as audit
+import pytest
+import textcraft_multiworld as multi
+import textcraft_recipe_binder as binder
+
+
+def test_checked_world47_recipe_binding_replays_and_rejects_tampered_receipt():
+    plan, tasks, _ = multi.build(47, "original", "public")
+    task, world = tasks[0], multi.checked_world(plan)
+    bridge = multi.c.bridge
+    collector_frame = bridge.Frame(
+        world,
+        dict(task["misc"]["initial_inventory"]),
+        task["misc"]["target_items"],
+        bridge.Budget(),
+        0,
+    )
+    target = next(iter(task["misc"]["target_items"]))
+    info_action = {"action": "get_info", "items": [target]}
+    info = collector_frame.apply(info_action)
+    history = [{"action": info_action, "feedback": info}]
+    recipe = info[0]["recipes"][0]
+    ingredient, amount = next(iter(recipe["ingredients"].items()))
+    requested = {
+        "action": "craft",
+        "target_item": target,
+        "output_count": recipe["result_count"],
+        "ingredients": {ingredient: amount + 1},
+    }
+    executed, reason = binder.bind_observed_recipe_arguments(requested, history)
+    feedback = collector_frame.apply(executed)
+    collector_history = history + [{"action": executed, "feedback": feedback}]
+
+    # Replay raw model JSON in an independent native frame.  The model-visible history
+    # contains only the executed action and real native feedback.
+    replay_frame = bridge.Frame(
+        world,
+        dict(task["misc"]["initial_inventory"]),
+        task["misc"]["target_items"],
+        bridge.Budget(),
+        0,
+    )
+    replay_info = replay_frame.apply(info_action)
+    replay_history = [{"action": info_action, "feedback": replay_info}]
+    parsed_requested = bridge.parse_action(json.dumps(requested))
+    replay_executed, replay_reason = binder.bind_observed_recipe_arguments(
+        parsed_requested, replay_history
+    )
+    replay_feedback = replay_frame.apply(replay_executed)
+    replay_history.append({"action": replay_executed, "feedback": replay_feedback})
+    assert replay_executed == executed
+    assert replay_reason == reason
+    assert replay_feedback == feedback
+    assert replay_history == collector_history
+    prompt1 = bridge.public_prompt(collector_frame, collector_history, goal=task["goal"])
+    prompt2 = bridge.public_prompt(replay_frame, replay_history, goal=task["goal"])
+    assert prompt1 == prompt2
+    receipt = {
+        "call_id": "c",
+        "requested_action": requested,
+        "executed_action": executed,
+        "binding_reason": reason,
+    }
+    audit.verify_execution_assist(receipt, "c", requested, executed, reason)
+    receipt["executed_action"] = requested
+    with pytest.raises(ValueError, match="binding mismatch"):
+        audit.verify_execution_assist(receipt, "c", requested, executed, reason)
