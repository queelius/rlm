+"""Fixed public endpoint, world47, automatic observed-recipe argument binding."""
+
+import argparse
+import json
+
+import textcraft_multiworld as multi
+
+OUTPUT = multi.c.ROOT / "textcraft-world47-public-recipe-binder-003"
+
+
+def prepare():
+    plan, tasks, binding = multi.build(47, "original", "public")
+    plan.update(
+        budget_seconds=1800,
+        execution_assist="For craft only, preserve model target_item/output_count and replace "
+        "ingredients only from one prior public get_info recipe if divisible; otherwise unchanged.",
+    )
+    path = OUTPUT / "PLAN.json"
+    if path.exists() and json.loads(path.read_text()) != plan:
+        raise ValueError("immutable binder pilot PLAN differs")
+    if not path.exists():
+        multi.c.save(path, plan)
+    return plan, tasks, binding
+
+
+def run(prepare_only: bool):
+    plan, tasks, binding = prepare()
+    multi.c.run(
+        argparse.Namespace(output=OUTPUT, prepare_only=prepare_only),
+        prepared_run=(plan, tasks),
+        adapter=binding,
+        world=None if prepare_only else multi.checked_world(plan),
+    )
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--prepare-only", action="store_true")
+    run(parser.parse_args().prepare_only)
