+"""Native audit for the changed-collector recipe-binder pilot."""
+
+import hashlib
+import json
+
+import analyze_textcraft_profiles as profiles
+import textcraft_multiworld as multi
+
+OUTPUT = multi.c.ROOT / "textcraft-world47-public-recipe-binder-003"
+REPORT = multi.c.ROOT / "analysis-textcraft-world47-public-recipe-binder-003.json"
+BASELINE = multi.c.ROOT / "textcraft-world47-seed2026092208-public-001"
+BASELINE_AUDIT = multi.c.ROOT / "analysis-textcraft-world47-seed2026092208-001.json"
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def run():
+    if REPORT.exists() or REPORT.with_suffix(".md").exists():
+        raise FileExistsError("immutable binder analysis exists")
+    plan, _, _ = multi.build(47, "original", "public")
+    saved = json.loads((OUTPUT / "PLAN.json").read_text())
+    if saved != {**plan, "budget_seconds": 1800, "execution_assist": saved["execution_assist"]}:
+        raise ValueError("saved changed-collector PLAN differs")
+    from transformers import AutoTokenizer
+
+    tokenizer = AutoTokenizer.from_pretrained(plan["model"], local_files_only=True)
+    result = profiles.audit.analyze(OUTPUT, tokenizer, world=multi.checked_world(plan))
+    result.pop("paired", None)
+    result.pop("depth_strata", None)
+    result["execution_assist"] = saved["execution_assist"]
+    pilot_rows = {
+        (row["task_id"], row["repeat"]): row
+        for row in (json.loads(path.read_text()) for path in (OUTPUT / "episodes").glob("*.json"))
+    }
+    baseline_rows = {
+        (row["task_id"], row["repeat"]): row
+        for row in (json.loads(path.read_text()) for path in (BASELINE / "episodes").glob("*.json"))
+    }
+    completed = json.loads(BASELINE_AUDIT.read_text())
+    baseline = completed["arms"][1]
+    for path in [BASELINE / "PLAN.json", *(BASELINE / "episodes").glob("*.json")]:
+        if baseline["sha256"].get(str(path)) != sha(path):
+            raise ValueError("authenticated unchanged-public audit receipt differs")
+    result["binder_minus_unchanged_public"] = profiles.compare(
+        saved["jobs"], baseline_rows, pilot_rows
+    )
+    result["unchanged_public_groups"] = baseline["groups"]
+    result["unchanged_public_audit_sha256"] = sha(BASELINE_AUDIT)
+    result["caveat"] = saved["caveat"]
+    multi.c.save(REPORT, result)
+    REPORT.with_suffix(".md").write_text(
+        "# World47 public recipe-binding pilot\n\n" + result["caveat"] + "\n"
+    )
+
+
+if __name__ == "__main__":
+    run()
