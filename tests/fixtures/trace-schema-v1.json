{
  "schema_version": "1",
  "envelope_fields": [
    "schema_version",
    "run_id",
    "event_id",
    "parent_event_id",
    "branch_id",
    "depth",
    "timestamp",
    "type",
    "payload"
  ],
  "manifest_fields": [
    "run_id",
    "status",
    "stop_reason",
    "turns",
    "duration_seconds",
    "usage",
    "error",
    "harness",
    "harness_fingerprint",
    "effective_config",
    "environment_abi",
    "environment_abi_digest",
    "schema_version"
  ],
  "event_types": [
    "run.started",
    "run.completed",
    "run.failed",
    "branch.started",
    "branch.completed",
    "model.request",
    "model.response",
    "model.failed",
    "controller.action",
    "controller.execution",
    "controller.observation",
    "controller.recovery_decision",
    "controller.repair"
  ],
  "required_payload_fields": {
    "run.started": [
      "request",
      "effective_config",
      "harness",
      "harness_fingerprint",
      "trace_schema_version",
      "environment_abi",
      "environment_abi_digest"
    ],
    "run.completed": ["stop_reason", "response"],
    "run.failed": ["error"],
    "branch.started": [
      "request",
      "controller_model",
      "prompt",
      "harness",
      "harness_fingerprint"
    ],
    "branch.completed": ["stop_reason", "response"],
    "model.request": ["context", "request"],
    "model.response": ["context", "duration_seconds", "response"],
    "model.failed": ["context", "duration_seconds", "error"],
    "controller.action": ["code"],
    "controller.execution": ["execution"],
    "controller.observation": ["observation"],
    "controller.recovery_decision": ["turn", "decision"],
    "controller.repair": ["turn", "fault", "observation"]
  },
  "canonical_direct_sequence": [
    "run.started",
    "model.request",
    "model.response",
    "run.completed"
  ],
  "canonical_repair_sequence": [
    "run.started",
    "branch.started",
    "model.request",
    "model.response",
    "controller.recovery_decision",
    "controller.repair",
    "model.request",
    "model.response",
    "controller.action",
    "controller.execution",
    "branch.completed",
    "run.completed"
  ],
  "canonical_recursive_sequence": [
    "run.started",
    "branch.started",
    "model.request",
    "model.response",
    "controller.action",
    "branch.started",
    "model.request",
    "model.response",
    "controller.action",
    "controller.execution",
    "branch.completed",
    "controller.execution",
    "branch.completed",
    "run.completed"
  ],
  "canonical_failure_sequence": [
    "run.started",
    "branch.started",
    "model.request",
    "model.failed",
    "run.failed"
  ]
}
